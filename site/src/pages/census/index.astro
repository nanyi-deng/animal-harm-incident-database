---
import Layout from '../../layouts/Layout.astro';
import census from '../../data/census.json';
import {
  CENSUS_CATEGORY_LABEL, CENSUS_CATEGORY_BLURB,
  CENSUS_CATEGORY_LABEL_EN, CENSUS_CATEGORY_BLURB_EN,
} from '../../lib/labels.js';
import { t, tZh } from '../../lib/i18n.js';

const categories = [...new Set(census.map((r) => r.category).filter(Boolean))].sort();
const animals = [...new Set(census.map((r) => r.animal).filter(Boolean))].sort();

function Tx(key, vars = {}) {
  return { en: t(key, vars), zh: tZh(key, vars) };
}

function getFlagKeys(r) {
  const keys = [];
  if (r.outcome_documented === 'false') keys.push('census.flag.outcome_undocumented');
  if (r.claim_verified === 'false') keys.push('census.flag.claim_unverified');
  if (r.animal_directly_harmed === 'false') keys.push('census.flag.animal_not_confirmed_harmed');
  if (r.perpetrator_confirmed === 'false') keys.push('census.flag.perpetrator_unconfirmed');
  if (r.recovered_after_theft === 'true') keys.push('census.flag.recovered');
  return keys;
}
---
<Layout title="判决书" description="AHID 判决书 census 子语料——涉动物伤害的刑事判决全量检索结果，可按分类、动物类型筛选，逐条展开阅读判决事实全文。">
  <div class="wrap-wide">
    <h1 style="margin: 40px 0 4px;" data-i18n data-en={Tx('census.title').en} data-zh={Tx('census.title').zh}>{Tx('census.title').en}</h1>
    <p style="color: var(--text-muted); max-width: 70ch;">
      <span data-i18n data-en={Tx('census.intro_1').en} data-zh={Tx('census.intro_1').zh}>{Tx('census.intro_1').en}</span><a
        href="https://huggingface.co/datasets/china-ai-law-challenge/cail2018" target="_blank" rel="noopener"
        data-i18n data-en={Tx('census.intro_cail_link').en} data-zh={Tx('census.intro_cail_link').zh}
      >{Tx('census.intro_cail_link').en}</a><span data-i18n data-en={Tx('census.intro_2', { n: census.length }).en} data-zh={Tx('census.intro_2', { n: census.length }).zh}>{Tx('census.intro_2', { n: census.length }).en}</span><a
        href="/methodology/" data-i18n data-en={Tx('census.intro_methodology_link').en} data-zh={Tx('census.intro_methodology_link').zh}
      >{Tx('census.intro_methodology_link').en}</a><span data-i18n data-en={Tx('census.intro_3').en} data-zh={Tx('census.intro_3').zh}>{Tx('census.intro_3').en}</span>
    </p>

    <div class="disclaimer">
      <strong data-i18n data-en={Tx('census.about_title').en} data-zh={Tx('census.about_title').zh}>{Tx('census.about_title').en}</strong> —
      <span data-i18n data-en={Tx('census.about_body').en} data-zh={Tx('census.about_body').zh}>{Tx('census.about_body').en}</span>
    </div>

    <div class="stat-row">
      <div class="stat"><span class="n">{census.length}</span><span class="label" data-i18n data-en={Tx('census.stat.total').en} data-zh={Tx('census.stat.total').zh}>{Tx('census.stat.total').en}</span></div>
      <div class="stat"><span class="n">{categories.length}</span><span class="label" data-i18n data-en={Tx('census.stat.categories').en} data-zh={Tx('census.stat.categories').zh}>{Tx('census.stat.categories').en}</span></div>
      <div class="stat"><span class="n">{census.filter((r) => r.category === 'poaching').length}</span><span class="label" data-i18n data-en={Tx('census.stat.poaching').en} data-zh={Tx('census.stat.poaching').zh}>{Tx('census.stat.poaching').en}</span></div>
      <div class="stat"><span class="n">{census.filter((r) => r.claim_verified === 'false' || r.outcome_documented === 'false' || r.animal_directly_harmed === 'false').length}</span><span class="label" data-i18n data-en={Tx('census.stat.presumed').en} data-zh={Tx('census.stat.presumed').zh}>{Tx('census.stat.presumed').en}</span></div>
    </div>

    <div class="filters">
      <select id="f-category"><option value="" data-i18n data-en={Tx('census.filter.all_categories').en} data-zh={Tx('census.filter.all_categories').zh}>{Tx('census.filter.all_categories').en}</option>
        {categories.map((c) => <option value={c}>{CENSUS_CATEGORY_LABEL[c] || c}</option>)}
      </select>
      <select id="f-animal"><option value="" data-i18n data-en={Tx('census.filter.all_animals').en} data-zh={Tx('census.filter.all_animals').zh}>{Tx('census.filter.all_animals').en}</option>
        {animals.map((a) => <option value={a}>{a}</option>)}
      </select>
      <input id="f-search" type="text" placeholder={Tx('census.filter.search_placeholder').en} data-i18n-placeholder data-en={Tx('census.filter.search_placeholder').en} data-zh={Tx('census.filter.search_placeholder').zh} />
    </div>

    <p id="count-line" style="color: var(--text-muted); font-size: 0.88rem; margin: 4px 0 16px;"
       data-i18n-count data-en-tpl={Tx('census.count_line').en} data-zh-tpl={Tx('census.count_line').zh}></p>

    <div id="list">
      {census.map((r, idx) => {
        const catEn = CENSUS_CATEGORY_LABEL_EN[r.category] || r.category;
        const catZh = CENSUS_CATEGORY_LABEL[r.category] || r.category;
        const blurbEn = CENSUS_CATEGORY_BLURB_EN[r.category] || '';
        const blurbZh = CENSUS_CATEGORY_BLURB[r.category] || '';
        const flagKeys = getFlagKeys(r);
        const reviewEn = r.review_status === 'reviewed' ? t('census.review.human') : t('census.review.auto');
        const reviewZh = r.review_status === 'reviewed' ? tZh('census.review.human') : tZh('census.review.auto');
        const motiveEn = r.motive || t('census.motive_unextracted');
        const motiveZh = r.motive || tZh('census.motive_unextracted');
        const countEn = r.n_animals || t('census.count_unknown');
        const countZh = r.n_animals || tZh('census.count_unknown');
        const metaEn = t('census.meta_line', { id: r.census_id, charges: r.charges, motive: motiveEn, count: countEn, confidence: r.confidence, review: reviewEn });
        const metaZh = tZh('census.meta_line', { id: r.census_id, charges: r.charges, motive: motiveZh, count: countZh, confidence: r.confidence, review: reviewZh });
        return (
          <div class="census-item" data-category={r.category || ''} data-animal={r.animal || ''}
               data-search={`${r.summary} ${r.charges} ${r.motive}`.toLowerCase()}>
            <button class="census-row" data-target={`detail-${idx}`}>
              <div class="meta-row">
                <span class="badge-outline" data-i18n data-en={catEn} data-zh={catZh}>{catEn}</span>
                {r.animal
                  ? <span class="badge-outline">{r.animal}</span>
                  : <span class="badge-outline" data-i18n data-en={Tx('census.animal_unknown').en} data-zh={Tx('census.animal_unknown').zh}>{Tx('census.animal_unknown').en}</span>}
                <span class="badge-outline">{r.charges}</span>
              </div>
              <div class="summary">{r.summary}</div>
            </button>
            <div class="census-detail" id={`detail-${idx}`} hidden>
              <p class="detail-label">
                <span data-i18n data-en={catEn} data-zh={catZh}>{catEn}</span> —{' '}
                <span data-i18n data-en={blurbEn} data-zh={blurbZh}>{blurbEn}</span>
              </p>
              {flagKeys.length > 0 && (
                <p class="detail-flag">
                  <span data-i18n data-en={Tx('census.flag_label').en} data-zh={Tx('census.flag_label').zh}>{Tx('census.flag_label').en}</span>
                  {flagKeys.map((k) => <span data-i18n data-en={Tx(k).en} data-zh={Tx(k).zh}>{Tx(k).en} </span>)}
                </p>
              )}
              {r.correction_note && (
                <p class="detail-note">
                  <span data-i18n data-en={Tx('census.note_label').en} data-zh={Tx('census.note_label').zh}>{Tx('census.note_label').en}</span>{r.correction_note}
                </p>
              )}
              <p class="detail-fact-note" data-i18n data-en={Tx('census.fact_untranslated').en} data-zh={Tx('census.fact_untranslated').zh}>{Tx('census.fact_untranslated').en}</p>
              <p class="detail-fact">{r.fact}</p>
              <p class="detail-meta" data-i18n data-en={metaEn} data-zh={metaZh}>{metaEn}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <script>
    const categorySel = document.getElementById('f-category');
    const animalSel = document.getElementById('f-animal');
    const searchInput = document.getElementById('f-search');
    const countLine = document.getElementById('count-line');
    const items = Array.from(document.querySelectorAll('.census-item'));

    function applyFilters() {
      const category = categorySel.value, animal = animalSel.value;
      const search = searchInput.value.trim().toLowerCase();
      let shown = 0;
      for (const el of items) {
        const show =
          (!category || el.dataset.category === category) &&
          (!animal || el.dataset.animal === animal) &&
          (!search || el.dataset.search.includes(search));
        el.style.display = show ? '' : 'none';
        if (show) shown++;
      }
      const locale = window.AHID_LOCALE || 'en';
      const tpl = locale === 'zh' ? countLine.dataset.zhTpl : countLine.dataset.enTpl;
      countLine.textContent = tpl.replace('{shown}', shown).replace('{total}', items.length);
    }
    for (const el of [categorySel, animalSel]) el.addEventListener('change', applyFilters);
    searchInput.addEventListener('input', applyFilters);
    window.addEventListener('ahid-locale-changed', applyFilters);
    applyFilters();

    // Expand/collapse -- one item at a time is not enforced, visitors can open
    // several; each button only toggles its own detail panel.
    document.getElementById('list').addEventListener('click', (e) => {
      const btn = e.target.closest('.census-row');
      if (!btn) return;
      const detail = document.getElementById(btn.dataset.target);
      const willShow = detail.hidden;
      detail.hidden = !willShow;
      btn.setAttribute('aria-expanded', String(willShow));
    });
  </script>

  <style>
    .census-item {
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 10px;
      overflow: hidden;
    }
    .census-row {
      display: block;
      width: 100%;
      text-align: left;
      background: var(--bg-raised);
      border: none;
      padding: 14px 16px;
      cursor: pointer;
      font: inherit;
      color: inherit;
    }
    .census-row:hover { background: var(--bg-hover, var(--bg-raised)); }
    .census-row .meta-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
    .census-row .summary { color: var(--text-muted); font-size: 0.94rem; }
    .census-detail {
      padding: 16px;
      border-top: 1px solid var(--border);
      background: var(--bg);
    }
    .detail-label { font-weight: 600; margin-bottom: 8px; }
    .detail-flag {
      font-size: 0.88rem;
      color: var(--status-ax);
      background: color-mix(in srgb, var(--status-ax) 12%, transparent);
      padding: 8px 10px;
      border-radius: 6px;
      margin-bottom: 10px;
    }
    .detail-note {
      font-size: 0.88rem;
      color: var(--text-muted);
      font-style: italic;
      margin-bottom: 10px;
    }
    .detail-fact-note {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-style: italic;
      margin-bottom: 6px;
    }
    .detail-fact {
      white-space: pre-wrap;
      line-height: 1.7;
      font-size: 0.94rem;
      margin-bottom: 10px;
    }
    .detail-meta { font-size: 0.82rem; color: var(--text-muted); }
    #f-search {
      padding: 8px 10px;
      font: inherit;
      color: var(--text);
      background: var(--bg-raised);
      border: 1px solid var(--border);
      border-radius: 6px;
      min-width: 220px;
    }
  </style>
</Layout>
