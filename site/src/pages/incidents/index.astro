---
import Layout from '../../layouts/Layout.astro';
import incidents from '../../data/incidents.json';
import { STATUS_LABEL, STATUS_LABEL_EN, locationLabel } from '../../lib/labels.js';
import { t, tZh } from '../../lib/i18n.js';

const sorted = [...incidents].sort((a, b) => (b.event_date_start || '').localeCompare(a.event_date_start || ''));
const provinces = [...new Set(incidents.map((i) => i.province).filter(Boolean))].sort();
const categories = [...new Set(incidents.map((i) => i.animal_category).filter(Boolean))].sort();
const statuses = [...new Set(incidents.map((i) => i.automation_status).filter(Boolean))];

function Tx(key, vars = {}) {
  return { en: t(key, vars), zh: tZh(key, vars) };
}
---
<Layout title="事件列表" description="AHID 已收录事件列表，可按省份、动物类型、自动状态筛选。">
  <div class="wrap-wide">
    <h1 style="margin: 40px 0 4px;" data-i18n data-en={Tx('incidents.title').en} data-zh={Tx('incidents.title').zh}>{Tx('incidents.title').en}</h1>
    <p style="color: var(--text-muted);" data-i18n
       data-en={Tx('incidents.intro', { n: incidents.length }).en} data-zh={Tx('incidents.intro', { n: incidents.length }).zh}>{Tx('incidents.intro', { n: incidents.length }).en}</p>

    <div class="filters">
      <select id="f-province"><option value="" data-i18n data-en={Tx('incidents.filter.all_provinces').en} data-zh={Tx('incidents.filter.all_provinces').zh}>{Tx('incidents.filter.all_provinces').en}</option>
        {provinces.map((p) => <option value={p}>{p}</option>)}
      </select>
      <select id="f-category"><option value="" data-i18n data-en={Tx('incidents.filter.all_categories').en} data-zh={Tx('incidents.filter.all_categories').zh}>{Tx('incidents.filter.all_categories').en}</option>
        {categories.map((c) => <option value={c}>{c}</option>)}
      </select>
      <select id="f-status"><option value="" data-i18n data-en={Tx('incidents.filter.all_statuses').en} data-zh={Tx('incidents.filter.all_statuses').zh}>{Tx('incidents.filter.all_statuses').en}</option>
        {statuses.map((s) => <option value={s} data-i18n data-en={STATUS_LABEL_EN[s] || s} data-zh={STATUS_LABEL[s] || s}>{STATUS_LABEL_EN[s] || s}</option>)}
      </select>
      <select id="f-minor"><option value="" data-i18n data-en={Tx('incidents.filter.minor_unrestricted').en} data-zh={Tx('incidents.filter.minor_unrestricted').zh}>{Tx('incidents.filter.minor_unrestricted').en}</option>
        <option value="yes" data-i18n data-en={Tx('incidents.filter.minor_yes').en} data-zh={Tx('incidents.filter.minor_yes').zh}>{Tx('incidents.filter.minor_yes').en}</option>
        <option value="no" data-i18n data-en={Tx('incidents.filter.minor_no').en} data-zh={Tx('incidents.filter.minor_no').zh}>{Tx('incidents.filter.minor_no').en}</option>
      </select>
    </div>

    <div id="list">
      {sorted.map((i) => (
        <a class="incident-list-item" data-province={i.province || ''} data-category={i.animal_category || ''}
           data-status={i.automation_status || ''} data-minor={i.minor_involvement || ''}
           href={`/incidents/${i.incident_id}/`}>
          <div class="meta-row">
            <span class={`badge badge-${i.automation_status}`} data-i18n
                  data-en={STATUS_LABEL_EN[i.automation_status]} data-zh={STATUS_LABEL[i.automation_status]}>{STATUS_LABEL_EN[i.automation_status]}</span>
            <span class="badge-outline">{locationLabel(i)}</span>
            <span class="badge-outline" data-i18n data-en={Tx('home.date_unknown').en} data-zh={Tx('home.date_unknown').zh}>{i.event_date_start || Tx('home.date_unknown').en}</span>
            {i.disputed_flag === 1 && (
              <span class="badge-outline" style="color: var(--status-ax);" data-i18n
                    data-en={Tx('incidents.disputed_badge').en} data-zh={Tx('incidents.disputed_badge').zh}>{Tx('incidents.disputed_badge').en}</span>
            )}
          </div>
          <div class="summary">
            {i.incident_id} · {i.animal_category} ·{' '}
            <span data-i18n data-en={i.harm_categories ? (i.harm_categories || '').split('|').join('、') : Tx('incidents.af_placeholder').en}
                  data-zh={i.harm_categories ? (i.harm_categories || '').split('|').join('、') : Tx('incidents.af_placeholder').zh}>
              {i.harm_categories ? (i.harm_categories || '').split('|').join('、') : Tx('incidents.af_placeholder').en}
            </span>
            {' · '}<span data-i18n data-en={Tx('incidents.evidence_sufficiency_label').en} data-zh={Tx('incidents.evidence_sufficiency_label').zh}>{Tx('incidents.evidence_sufficiency_label').en}</span>{' '}
            {i.evidence_sufficiency_score ?? '—'}/100
          </div>
        </a>
      ))}
    </div>
  </div>

  <script>
    const provinceSel = document.getElementById('f-province');
    const categorySel = document.getElementById('f-category');
    const statusSel = document.getElementById('f-status');
    const minorSel = document.getElementById('f-minor');
    const items = Array.from(document.querySelectorAll('#list > a'));

    function applyFilters() {
      const province = provinceSel.value, category = categorySel.value, status = statusSel.value, minor = minorSel.value;
      for (const el of items) {
        const show =
          (!province || el.dataset.province === province) &&
          (!category || el.dataset.category === category) &&
          (!status || el.dataset.status === status) &&
          (!minor || el.dataset.minor === minor);
        el.style.display = show ? '' : 'none';
      }
    }
    for (const sel of [provinceSel, categorySel, statusSel, minorSel]) {
      sel.addEventListener('change', applyFilters);
    }
  </script>
</Layout>
