---
import Layout from '../layouts/Layout.astro';
import incidents from '../data/incidents.json';
import census from '../data/census.json';
import { STATUS_LABEL, STATUS_LABEL_EN, isPublishable, locationLabel } from '../lib/labels.js';
import { t, tZh } from '../lib/i18n.js';

const publishable = incidents.filter(isPublishable);
const latest = [...publishable]
  .sort((a, b) => (b.event_date_start || '').localeCompare(a.event_date_start || ''))
  .slice(0, 6);

const provinces = new Set(incidents.map((i) => i.province).filter(Boolean));
const withOfficialResponse = incidents.filter((i) => i.official_response_found === 1).length;
const disputedOrAF = incidents.filter((i) => ['AX', 'AF'].includes(i.automation_status)).length;

function Tx(key, vars = {}) {
  return { en: t(key, vars), zh: tZh(key, vars) };
}
---
<Layout title="首页" description="动物伤害事件数据库（AHID）——自动化、多语言、以公开来源为基础的事件监测系统。">
  <div class="wrap">
    <section style="padding: 48px 0 8px;">
      <h1 style="font-size: 2.1rem; margin-bottom: 12px;" data-i18n data-en={Tx('home.h1').en} data-zh={Tx('home.h1').zh}>{Tx('home.h1').en}</h1>
      <p style="font-size: 1.08rem; color: var(--text-muted); max-width: 60ch;">
        <span data-i18n data-en={Tx('home.intro_1').en} data-zh={Tx('home.intro_1').zh}>{Tx('home.intro_1').en}</span><a
          href="/incidents/" data-i18n data-en={Tx('home.intro_incidents_link').en} data-zh={Tx('home.intro_incidents_link').zh}
        >{Tx('home.intro_incidents_link').en}</a><span data-i18n data-en={Tx('home.intro_2').en} data-zh={Tx('home.intro_2').zh}>{Tx('home.intro_2').en}</span><a
          href="/census/" data-i18n data-en={Tx('home.intro_census_link').en} data-zh={Tx('home.intro_census_link').zh}
        >{Tx('home.intro_census_link').en}</a><span data-i18n data-en={Tx('home.intro_3').en} data-zh={Tx('home.intro_3').zh}>{Tx('home.intro_3').en}</span>
      </p>
    </section>

    <div class="disclaimer">
      <strong data-i18n data-en={Tx('home.disclaimer_title').en} data-zh={Tx('home.disclaimer_title').zh}>{Tx('home.disclaimer_title').en}</strong> —
      <span data-i18n data-en={Tx('home.disclaimer_body').en} data-zh={Tx('home.disclaimer_body').zh}>{Tx('home.disclaimer_body').en}</span>
    </div>

    <div class="stat-row">
      <div class="stat"><span class="n">{incidents.length}</span><span class="label" data-i18n data-en={Tx('home.stat.incidents').en} data-zh={Tx('home.stat.incidents').zh}>{Tx('home.stat.incidents').en}</span></div>
      <div class="stat"><span class="n">{publishable.length}</span><span class="label" data-i18n data-en={Tx('home.stat.publishable').en} data-zh={Tx('home.stat.publishable').zh}>{Tx('home.stat.publishable').en}</span></div>
      <div class="stat"><span class="n">{provinces.size}</span><span class="label" data-i18n data-en={Tx('home.stat.provinces').en} data-zh={Tx('home.stat.provinces').zh}>{Tx('home.stat.provinces').en}</span></div>
      <div class="stat"><span class="n">{withOfficialResponse}</span><span class="label" data-i18n data-en={Tx('home.stat.official_response').en} data-zh={Tx('home.stat.official_response').zh}>{Tx('home.stat.official_response').en}</span></div>
    </div>

    <section style="margin-top: 40px;">
      <div class="section-label" data-i18n data-en={Tx('home.section.latest').en} data-zh={Tx('home.section.latest').zh}>{Tx('home.section.latest').en}</div>
      {latest.map((i) => (
        <a class="incident-list-item" href={`/incidents/${i.incident_id}/`}>
          <div class="meta-row">
            <span class={`badge badge-${i.automation_status}`} data-i18n
                  data-en={STATUS_LABEL_EN[i.automation_status]} data-zh={STATUS_LABEL[i.automation_status]}>{STATUS_LABEL_EN[i.automation_status]}</span>
            <span class="badge-outline">{locationLabel(i)}</span>
            <span class="badge-outline" data-i18n data-en={Tx('home.date_unknown').en} data-zh={Tx('home.date_unknown').zh}>{i.event_date_start || Tx('home.date_unknown').en}</span>
          </div>
          <div class="summary">{i.incident_id} · {i.animal_category} · {(i.harm_categories || '').split('|').join('、')}</div>
        </a>
      ))}
      <p><a href="/incidents/" data-i18n data-en={Tx('home.link.view_all_incidents', { n: incidents.length }).en} data-zh={Tx('home.link.view_all_incidents', { n: incidents.length }).zh}>{Tx('home.link.view_all_incidents', { n: incidents.length }).en}</a></p>
    </section>

    <section style="margin-top: 40px;">
      <div class="section-label" data-i18n data-en={Tx('home.section.census').en} data-zh={Tx('home.section.census').zh}>{Tx('home.section.census').en}</div>
      <p style="color: var(--text-muted); font-size: 0.94rem; max-width: 60ch;" data-i18n
         data-en={Tx('home.census_body', { n: census.length }).en} data-zh={Tx('home.census_body', { n: census.length }).zh}>{Tx('home.census_body', { n: census.length }).en}</p>
      <p><a href="/census/" data-i18n data-en={Tx('home.link.view_all_census', { n: census.length }).en} data-zh={Tx('home.link.view_all_census', { n: census.length }).zh}>{Tx('home.link.view_all_census', { n: census.length }).en}</a></p>
    </section>

    <section style="margin-top: 40px;">
      <div class="section-label" data-i18n data-en={Tx('home.section.bias').en} data-zh={Tx('home.section.bias').zh}>{Tx('home.section.bias').en}</div>
      <p style="color: var(--text-muted); font-size: 0.94rem;">
        <span data-i18n data-en={Tx('home.bias_body', { n: disputedOrAF }).en} data-zh={Tx('home.bias_body', { n: disputedOrAF }).zh}>{Tx('home.bias_body', { n: disputedOrAF }).en}</span><a
          href="/methodology/" data-i18n data-en={Tx('home.bias_methodology_link').en} data-zh={Tx('home.bias_methodology_link').zh}
        >{Tx('home.bias_methodology_link').en}</a><span data-i18n data-en={Tx('home.bias_end').en} data-zh={Tx('home.bias_end').zh}>{Tx('home.bias_end').en}</span>
      </p>
    </section>
  </div>
</Layout>
